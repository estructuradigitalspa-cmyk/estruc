# Elytsa local/staging configuration. Copy to .env.local and add real values there only.
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://elytsa-staging.vercel.app
NEXT_PUBLIC_APP_URL=https://elytsa-staging.vercel.app

# Safety gates: keep false until an authorized staging validation.
ALLOW_EXTERNAL_MESSAGES=false
ALLOW_REAL_WHATSAPP=false
ENABLE_GLOBAL_WHATSAPP_FALLBACK=false

# Dedicated Elytsa staging Supabase project. Never reuse production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Simulated by default. Model and prices are runtime configuration, not assumptions.
LLM_PROVIDER=simulated
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE_URL=
LLM_INPUT_PRICE=
LLM_OUTPUT_PRICE=

# Human contact and transactional email remain non-operational without verification.
CONTACT_TO_EMAIL=
CONTACT_REPLY_TO_EMAIL=contacto@elytsa.com
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# Meta/WhatsApp staging credentials, only after explicit authorization.
META_LOGIN_APP_ID=
META_LOGIN_APP_SECRET=
META_BUSINESS_APP_ID=
META_BUSINESS_APP_SECRET=
META_BUSINESS_CONFIG_ID=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_OAUTH_STATE_SECRET=
META_TOKEN_ENCRYPTION_KEY_V1=
META_TOKEN_ENCRYPTION_KEY_V2=
META_TOKEN_ENCRYPTION_ACTIVE_VERSION=v1
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WABA_ID=

RATE_LIMIT_CONTACT=5
RATE_LIMIT_WHATSAPP_USER=30
RATE_LIMIT_WHATSAPP_ORG=100
RATE_LIMIT_META_ATTEMPTS=10
RATE_LIMIT_DATA_DELETION=5
CRON_SECRET=
WEBHOOK_WORKER_BATCH_SIZE=50
