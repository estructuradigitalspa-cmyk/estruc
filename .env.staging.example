# Staging only. Never copy production credentials into this file.
APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.example.invalid
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Real LLM is opt-in per organization and requires this server-only key.
LLM_PROVIDER=openai_compatible
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# External messages remain disabled throughout staging setup.
ALLOW_EXTERNAL_MESSAGES=false
ALLOW_REAL_WHATSAPP=false
RESEND_API_KEY=
